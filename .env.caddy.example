# Public DNS name resolving directly to this Docker host.
ADDRESS_BOOK_DOMAIN=ab.example.com

# Required by Caddy's ACME issuer for operational notices.
ACME_EMAIL=admin@example.com

# Generate once and keep unchanged: openssl rand -hex 32
JWT_SECRET=replace-with-a-persistent-random-value

# Generate once and store outside version control.
AB_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: 1 automatically adds client sysinfo devices to the admin's book.
AUTO_ADD_DEVICES=0
